{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.matchanalysispro.online/radar/schema/evidence.schema.json",
  "title": "Radar evidence (optional extra proof on a pick)",
  "type": "object",
  "required": [
    "player_id",
    "type",
    "date"
  ],
  "additionalProperties": false,
  "properties": {
    "player_id": {
      "type": "string",
      "pattern": "^[EU][0-9]{2}-[0-9]{3}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "video",
        "note",
        "source"
      ]
    },
    "partner": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "note": {
      "type": "string"
    }
  },
  "anyOf": [
    {
      "required": [
        "url"
      ]
    },
    {
      "required": [
        "path"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "note"
        }
      },
      "required": [
        "note"
      ]
    }
  ]
}
