{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.matchanalysispro.online/radar/schema/release.schema.json",
  "title": "Radar release",
  "type": "object",
  "required": [
    "id",
    "title",
    "written",
    "season",
    "scope",
    "method_version",
    "public",
    "picks"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "written": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "season": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": [
        "competition",
        "group"
      ],
      "additionalProperties": false,
      "properties": {
        "competition": {
          "type": "string"
        },
        "group": {
          "type": "string"
        }
      }
    },
    "method_version": {
      "type": "string",
      "minLength": 1
    },
    "public": {
      "type": "boolean"
    },
    "pool_csv": {
      "type": "string"
    },
    "errata_csv": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "approx": {
            "type": "boolean"
          }
        }
      }
    },
    "picks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "club",
          "chosen"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[EU][0-9]{2}-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "club": {
            "type": "string",
            "minLength": 1
          },
          "chosen": {
            "type": "boolean"
          },
          "in_pool_csv": {
            "type": "boolean"
          },
          "why": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "age_label": {
            "type": "string"
          },
          "score": {
            "type": "string"
          },
          "caveat": {
            "type": "string"
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "url"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                }
              }
            }
          },
          "confidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "gol": {
                "type": "string"
              },
              "minuti": {
                "type": "string"
              },
              "assist": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
